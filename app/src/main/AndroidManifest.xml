<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Normal permission: the strength of the haptic ticks is chosen in Settings, which needs the vibrator directly. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Normal permission: lets a downward drag on Home pull the notification shade down. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Connected apps (Meet, Signal, WhatsApp) guard their call actions on a contact with this permission, so a
         tap on "Video call" or "Voice call" in search is refused without it. It is asked for at that tap, never at
         start. The launcher itself places no calls. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- CALL_PHONE implies a telephony radio to the store; the launcher runs without one. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Favorites can depend on which Bluetooth devices are connected. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Favorites can depend on which Meld modes are active; Meld defines this permission. -->
    <uses-permission android:name="me.jhot.meld.permission.READ_MODES" />

    <!-- An archived app has no launcher activity left, so the LAUNCHER query below cannot see it; without this the
         app list and search drop archived apps instead of marking them. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Package visibility: without the LAUNCHER query the app list, search and shortcut labels see
         almost no other app; without CREATE_SHORTCUT the create-shortcut activities are not listed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
        <!-- Browsers, for the Web link row under each on the Add shortcut sheet. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Meld's provider holds the modes conditions read. -->
        <package android:name="me.jhot.meld" />
    </queries>

    <application
        android:name=".SwiftcurrentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Swiftcurrent"
        android:supportsRtl="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection|fontWeightAdjustment|colorMode|navigation|touchscreen|mcc|mnc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The entry other launchers list. It opens Settings, since Home itself is not the point of a tap on the icon. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Another app (Activity Manager, say) asks to pin a shortcut: the system sends it here because we are the home app. -->
        <activity
            android:name=".shell.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Swiftcurrent.Translucent">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <service
            android:name=".lock.LockService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service_config" />
        </service>
    </application>
</manifest>
